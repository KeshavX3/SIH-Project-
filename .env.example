# ─── PostgreSQL / PostGIS ──────────────────────────────────────────────────
POSTGRES_DB=heatguard
POSTGRES_USER=heatguard
POSTGRES_PASSWORD=heatguard_secret_2024
DATABASE_URL=postgresql://heatguard:heatguard_secret_2024@db:5432/heatguard

# ─── JWT Authentication ────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Application Settings ──────────────────────────────────────────────────
DEMO_MODE=true
APP_ENV=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# ─── Weather API (Optional — leave blank to use Demo Provider) ─────────────
# OPENWEATHER_API_KEY=
# WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ─── ML Settings ───────────────────────────────────────────────────────────
ML_MODEL_PATH=app/ml/models/risk_model.pkl
RANDOM_SEED=42

# ─── Notification (Mock in Demo Mode) ─────────────────────────────────────
NOTIFICATION_MODE=mock
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
